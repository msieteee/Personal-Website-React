{
  "name": "react-personal-website",
  "version": "1.0.0",
  "description": "Personal website made from scratch using Next.js and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "author": "",
  "license": "ISC",
  "homepage": "https://www.miguelsietereales.com",
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^5.3.8",
    "firebase": "^12.8.0",
    "graphql": "^15.10.1",
    "graphql-type-json": "^0.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/styled-components": "^5.1.26",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
